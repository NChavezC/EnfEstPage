# Añadir estas claves a .env.local sin borrar las claves TUU existentes.
# No utilizar VITE_ para credenciales de servidor.
DATABASE_URL=postgresql://usuario:password@127.0.0.1:5432/enfest
AGENDA_ENV=development
AGENDA_PAYMENT_MODE=mock
AGENDA_PUBLIC_URL=http://localhost:5173
AGENDA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AGENDA_MAIL_MODE=file
# En producción: AGENDA_ENV=production, AGENDA_PAYMENT_MODE=tuu,
# URL HTTPS pública y origen exacto. DATABASE_URL de Neon con sslmode=require.
# SMTP con STARTTLS:
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=

# Vercel: consultar AGENDA_VERCEL.md. Mantener secretos fuera de Git.
AGENDA_MAIL_DISPATCH=worker
RESEND_API_KEY=
CRON_SECRET=
